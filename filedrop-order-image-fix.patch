+    order: any,
+  ): Array<{ uploadId: string; lineItemId?: string }> {
+    const refs: Array<{ uploadId: string; lineItemId?: string }> = [];
+    const uuidRe =
+      /[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}/i;
