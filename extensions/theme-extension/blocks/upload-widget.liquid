{
  "name": "Filedrop",
  "target": "section",
  "settings": [
    {
      "type": "text",
      "id": "api_url",
      "label": "App API URL",
      "default": "https://filedrop-production-6d21.up.railway.app/api/v1"
    },
    {
      "type": "color",
      "id": "button_color",
      "label": "Button Color",
      "default": "#008060"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "Upload File"
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Button Border Radius",
      "min": 0,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 4
    },
    {
      "type": "checkbox",
      "id": "enable_camera",
      "label": "Enable Camera Upload",
      "default": true,
      "info": "Shows a camera button for mobile photo capture"
    }
  ]
}
