{% comment %}
  Custom File Upload Pro - Product Page Upload Widget
  Theme App Extension Block — v2 (camera + image editor)
{% endcomment %}

<div
  id="cfup-upload-widget"
  class="cfup-widget"
  data-shop="{{ shop.permanent_domain }}"
  data-product-id="{{ product.id }}"
  data-variant-id="{{ product.selected_or_first_available_variant.id }}"
  data-product-image="{{ product.selected_or_first_available_variant.featured_image | default: product.featured_image | image_url: width: 1600 }}"
  data-api-url="{{ block.settings.api_url }}"
  data-button-color="{{ block.settings.button_color }}"
  data-button-text="{{ block.settings.button_text }}"
  data-border-radius="{{ block.settings.border_radius }}"
  data-enable-camera="{{ block.settings.enable_camera }}"
  data-cart-url="{{ routes.cart_url }}"
  data-cart-update-url="{{ routes.cart_update_url }}"
>
  <div id="cfup-fields-container"></div>
</div>

<!-- Cropper.js modal overlay -->
<div id="cfup-editor-modal" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,0.82);z-index:99999;align-items:center;justify-content:center;flex-direction:column;">
  <div style="background:#fff;border-radius:12px;max-width:680px;width:calc(100% - 32px);padding:20px;box-shadow:0 24px 64px rgba(0,0,0,.4);">
    <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:16px;">
      <strong style="font-size:16px;">Edit Image</strong>
      <button id="cfup-editor-close" style="background:none;border:none;font-size:22px;cursor:pointer;color:#555;">✕</button>
    </div>
    <div style="position:relative;max-height:420px;overflow:hidden;border-radius:8px;background:#111;">
      <img id="cfup-editor-img" src="" alt="Edit" width="800" height="600" style="max-width:100%;display:block;" />
    </div>
    <div style="margin-top:14px;display:flex;gap:10px;flex-wrap:wrap;align-items:center;">
      <button class="cfup-editor-btn" id="cfup-rotate-left" title="Rotate Left">↺ Rotate Left</button>
      <button class="cfup-editor-btn" id="cfup-rotate-right" title="Rotate Right">↻ Rotate Right</button>
      <button class="cfup-editor-btn" id="cfup-zoom-in" title="Zoom In">＋ Zoom In</button>
      <button class="cfup-editor-btn" id="cfup-zoom-out" title="Zoom Out">－ Zoom Out</button>
      <button class="cfup-editor-btn" id="cfup-reset" title="Reset">⟲ Reset</button>
      <div style="flex:1;"></div>
      <button id="cfup-editor-apply" style="background:#008060;color:#fff;border:none;border-radius:6px;padding:10px 22px;font-weight:700;cursor:pointer;font-size:14px;">
        Apply &amp; Upload
      </button>
    </div>
  </div>
</div>

<!-- Product-preview modal: shows the customer's image composited onto the merchant's mockup template -->
<div id="cfup-preview-modal" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,0.82);z-index:99999;align-items:center;justify-content:center;flex-direction:column;">
  <div style="background:#fff;border-radius:12px;max-width:680px;width:calc(100% - 32px);padding:20px;box-shadow:0 24px 64px rgba(0,0,0,.4);">
    <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:16px;">
      <strong style="font-size:16px;">Preview on Product</strong>
      <button id="cfup-preview-close" style="background:none;border:none;font-size:22px;cursor:pointer;color:#555;">✕</button>
    </div>
    <div style="position:relative;max-height:420px;display:flex;align-items:center;justify-content:center;border-radius:8px;background:#f4f4f4;overflow:hidden;">
      <canvas id="cfup-preview-canvas" style="max-width:100%;max-height:420px;display:block;"></canvas>
    </div>
    <p style="margin:10px 0 0;font-size:13px;color:#666;">This is an approximate preview to help you check placement and sizing.</p>
    <div style="margin-top:14px;display:flex;gap:10px;flex-wrap:wrap;align-items:center;">
      <button class="cfup-editor-btn" id="cfup-preview-back">← Back</button>
      <div style="flex:1;"></div>
      <button id="cfup-preview-confirm" style="background:#008060;color:#fff;border:none;border-radius:6px;padding:10px 22px;font-weight:700;cursor:pointer;font-size:14px;">
        Looks Good, Upload
      </button>
    </div>
  </div>
</div>

<!-- Interactive designer: customer drags/resizes/rotates their image and can add text -->
<div id="cfup-designer-modal" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,0.82);z-index:99999;align-items:center;justify-content:center;flex-direction:column;">
  <div style="background:#fff;border-radius:12px;max-width:720px;width:calc(100% - 32px);max-height:90vh;overflow-y:auto;padding:20px;box-shadow:0 24px 64px rgba(0,0,0,.4);">
    <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:16px;">
      <strong style="font-size:16px;">Design Your Product</strong>
      <button id="cfup-designer-close" style="background:none;border:none;font-size:22px;cursor:pointer;color:#555;">✕</button>
    </div>
    <div style="display:flex;justify-content:center;background:#f4f4f4;border-radius:8px;overflow:hidden;">
      <canvas id="cfup-designer-canvas"></canvas>
    </div>
    <div style="margin-top:14px;display:flex;gap:10px;flex-wrap:wrap;align-items:center;">
      <button class="cfup-editor-btn" id="cfup-designer-rotate-left" title="Rotate Left">↺ Rotate</button>
      <button class="cfup-editor-btn" id="cfup-designer-rotate-right" title="Rotate Right">↻ Rotate</button>
      <button class="cfup-editor-btn" id="cfup-designer-add-text" title="Add Text">＋ Add Text</button>
      <input type="color" id="cfup-designer-text-color" value="#000000" title="Text color" style="width:36px;height:36px;border:none;border-radius:6px;cursor:pointer;padding:0;display:none;" />
      <button class="cfup-editor-btn" id="cfup-designer-delete-selected" title="Delete selected" style="display:none;">🗑 Delete</button>
      <div style="flex:1;"></div>
      <button id="cfup-designer-confirm" style="background:#008060;color:#fff;border:none;border-radius:6px;padding:10px 22px;font-weight:700;cursor:pointer;font-size:14px;">
        Use This Design
      </button>
    </div>
  </div>
</div>



<!-- Cropper.js and Fabric.js are loaded on demand (see loadScriptOnce) only when
     the optional image editor/designer is opened, so they no longer download on
     every storefront page load. -->

<style>
  :root {
    --cfup-btn-color: {{ block.settings.button_color | default: '#008060' }};
    --cfup-btn-radius: {{ block.settings.border_radius | default: 4 }}px;
  }

  .cfup-widget { margin: 16px 0; }

  .cfup-field-wrapper {
    margin-bottom: 20px;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
  }

  .cfup-field-label {
    display: block;
    font-size: 14px;
    font-weight: 600;
    margin-bottom: 6px;
    color: #1a1a1a;
  }

  .cfup-field-label .cfup-required { color: #cc0000; margin-left: 2px; }

  .cfup-required-msg {
    color: #cc0000;
    font-size: 14px;
    line-height: 1.4;
    margin: 10px 0 0;
    font-weight: 500;
  }
  .cfup-disabled {
    opacity: 0.5 !important;
    cursor: not-allowed !important;
    pointer-events: none !important;
  }

  .cfup-field-description {
    font-size: 13px;
    color: #666;
    margin-bottom: 8px;
  }

  .cfup-dropzone {
    border: 2px dashed #d0d0d0;
    border-radius: 8px;
    padding: 24px;
    text-align: center;
    cursor: pointer;
    transition: border-color .2s, background .2s;
    position: relative;
    background: #fafafa;
  }

  .cfup-dropzone:hover,
  .cfup-dropzone.cfup-dragover {
    border-color: var(--cfup-btn-color);
    background: #f0faf8;
  }

  .cfup-dropzone input[type="file"] {
    position: absolute;
    inset: 0;
    opacity: 0;
    cursor: pointer;
    width: 100%;
    height: 100%;
  }

  .cfup-dropzone-icon { font-size: 36px; display: block; margin-bottom: 8px; }
  .cfup-dropzone-text { font-size: 14px; color: #555; }

  .cfup-upload-actions {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    margin-top: 12px;
    justify-content: center;
  }

  .cfup-button {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 10px 20px;
    background: var(--cfup-btn-color);
    color: #fff;
    border: none;
    border-radius: var(--cfup-btn-radius);
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
    transition: opacity .2s;
  }

  .cfup-button:hover { opacity: .88; }

  .cfup-button-secondary {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 10px 20px;
    background: #fff;
    color: var(--cfup-btn-color);
    border: 2px solid var(--cfup-btn-color);
    border-radius: var(--cfup-btn-radius);
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
  }

  .cfup-progress-bar-wrapper {
    margin-top: 12px;
    background: #f0f0f0;
    border-radius: 4px;
    overflow: hidden;
  }

  .cfup-progress-bar-track { height: 6px; background: #e8e8e8; border-radius: 4px; }
  .cfup-progress-bar-fill {
    height: 6px;
    background: var(--cfup-btn-color);
    border-radius: 4px;
    transition: width .2s;
    width: 0%;
  }
  .cfup-progress-text { font-size: 12px; color: #555; margin-top: 4px; text-align: center; }

  .cfup-file-list { margin-top: 12px; display: flex; flex-direction: column; gap: 8px; }

  .cfup-file-item {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 10px 12px;
    background: #fff;
    border: 1px solid #e8e8e8;
    border-radius: 8px;
    position: relative;
  }

  .cfup-file-preview {
    width: 48px;
    height: 48px;
    object-fit: cover;
    border-radius: 6px;
    flex-shrink: 0;
    border: 1px solid #eee;
  }

  .cfup-file-info { flex: 1; min-width: 0; }
  .cfup-file-name { font-size: 13px; font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .cfup-file-size { font-size: 12px; color: #888; margin-top: 2px; }

  .cfup-file-status { font-size: 12px; font-weight: 600; flex-shrink: 0; }
  .cfup-file-status.uploading { color: #666; }
  .cfup-file-status.success { color: #008060; }
  .cfup-file-status.error { color: #cc0000; }

  .cfup-file-remove {
    position: absolute;
    top: 6px;
    right: 8px;
    background: none;
    border: none;
    cursor: pointer;
    color: #aaa;
    font-size: 16px;
    line-height: 1;
    padding: 2px 4px;
  }
  .cfup-file-remove:hover { color: #cc0000; }

  .cfup-error {
    background: #fff3f3;
    border: 1px solid #ffc5c5;
    border-radius: 6px;
    color: #cc0000;
    font-size: 13px;
    padding: 10px 14px;
    margin-top: 10px;
  }

  .cfup-help-text {
    font-size: 12px;
    color: #888;
    margin-top: 8px;
  }

  .cfup-editor-btn {
    background: #f4f4f4;
    border: 1px solid #ddd;
    border-radius: 6px;
    padding: 8px 14px;
    font-size: 13px;
    cursor: pointer;
    transition: background .15s;
  }

  .cfup-editor-btn:hover { background: #e8e8e8; }

  @media (max-width: 480px) {
    .cfup-dropzone { padding: 16px; }
    .cfup-button, .cfup-button-secondary { padding: 10px 14px; font-size: 13px; }
  }
</style>

<script>
(function () {
  const widget = document.getElementById('cfup-upload-widget');
  if (!widget) return;

  // Guard against the block being initialized more than once on a page
  // (duplicate placement, or a theme re-rendering the section) — otherwise the
  // script would double-bind listeners and append duplicate fields.
  if (widget.dataset.cfupInit === '1') return;
  widget.dataset.cfupInit = '1';

  const SHOP         = widget.dataset.shop;
  const PRODUCT_ID   = widget.dataset.productId;
  let   PRODUCT_IMAGE = widget.dataset.productImage || '';
  const API_URL      = widget.dataset.apiUrl;
  const BTN_COLOR    = widget.dataset.buttonColor || '#008060';
  const BTN_TEXT     = widget.dataset.buttonText || 'Upload File';
  const ENABLE_CAMERA = widget.dataset.enableCamera === 'true';
  const container    = document.getElementById('cfup-fields-container');

  // Shopify cart routes, resolved by Liquid so they carry any subfolder/locale
  // prefix (e.g. "/en/cart", or "/app/cart" on a subfolder storefront). Using
  // these instead of hard-coded "/cart.js" keeps cart-token binding and
  // line-item properties working on custom-domain AND subfolder setups. The
  // "/cart" fallbacks cover any theme that doesn't expose routes.
  const CART_BASE        = widget.dataset.cartUrl || '/cart';
  const CART_UPDATE_BASE = widget.dataset.cartUpdateUrl || '/cart/update';
  const CART_JS_URL      = CART_BASE + '.js';
  const CART_UPDATE_URL  = CART_UPDATE_BASE + '.js';

  // Fail loudly in the console instead of silently rendering nothing — these
  // are the two most common "the widget doesn't show up" causes.
  if (!API_URL) {
    console.error('[Filedrop] No App API URL is set on the Filedrop block. Open the theme editor, select the Filedrop block, and set "App API URL". The widget cannot load without it.');
    return;
  }
  if (!SHOP) {
    console.error('[Filedrop] Could not determine the shop domain. The widget cannot load.');
    return;
  }

  // ── Lazy-load heavy image libraries only when actually needed ─────────────
  // Cropper.js and Fabric.js power the OPTIONAL image editor/designer. Loading
  // them on every product page (for every shopper) slowed the storefront for no
  // reason, so they're fetched on first use. Each loader resolves true when the
  // library is ready, false if the CDN is blocked/offline — callers then fall
  // back gracefully (upload the original file) instead of breaking.
  const CROPPER_JS  = 'https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.6.2/cropper.min.js';
  const CROPPER_CSS = 'https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.6.2/cropper.min.css';
  const FABRIC_JS   = 'https://cdnjs.cloudflare.com/ajax/libs/fabric.js/5.3.1/fabric.min.js';
  const _scriptCache = {};
  function loadScriptOnce(src) {
    if (_scriptCache[src]) return _scriptCache[src];
    _scriptCache[src] = new Promise((resolve, reject) => {
      const s = document.createElement('script');
      s.src = src;
      s.async = true;
      s.onload = () => resolve(true);
      s.onerror = () => { delete _scriptCache[src]; reject(new Error('load failed: ' + src)); };
      document.head.appendChild(s);
    });
    return _scriptCache[src];
  }
  function ensureCss(href) {
    if (document.querySelector('link[data-cfup-css="' + href + '"]')) return;
    const l = document.createElement('link');
    l.rel = 'stylesheet';
    l.href = href;
    l.setAttribute('data-cfup-css', href);
    document.head.appendChild(l);
  }
  async function ensureCropper() {
    if (window.Cropper) return true;
    ensureCss(CROPPER_CSS);
    try { await loadScriptOnce(CROPPER_JS); return !!window.Cropper; }
    catch (e) { console.error('[Filedrop] Image editor library failed to load.', e); return false; }
  }
  async function ensureFabric() {
    if (window.fabric) return true;
    try { await loadScriptOnce(FABRIC_JS); return !!window.fabric; }
    catch (e) { console.error('[Filedrop] Image designer library failed to load.', e); return false; }
  }

  widget.style.setProperty('--cfup-btn-color', BTN_COLOR);

  let allUploadedIds = [];
  // Per-required-field upload counters, rebuilt whenever fields (re)load. Used
  // to gate Add-to-Cart until every required field has at least one upload.
  const requiredFieldGetters = [];
  // Preview URLs for each uploaded file, written as Shopify line-item
  // properties so the image shows directly under the product on the order.
  let allUploadedPreviews = [];
  let cropper = null;
  let pendingEditorCallback = null;
  // Cached cart token for the lifetime of this page load — avoids
  // refetching /cart.js on every file upload/remove. Reset naturally on
  // navigation. Declared here (rather than down near getCartToken) since
  // rebindUploadsToRealCartToken(), defined just below, also needs it.
  let _cachedCartToken = null;

  // ── Rebind uploads to the cart's final token after Add to Cart ─────────────
  // See getCartToken() below for why the token captured at upload time can
  // be provisional. This detects a successful Add to Cart (by patching both
  // fetch and XMLHttpRequest, since different themes' cart drawers use
  // either) and re-syncs any uploads made earlier in this session to
  // whatever cart token Shopify has now finalized.

  async function rebindUploadsToRealCartToken() {
    if (!allUploadedIds.length) return;
    const oldToken = _cachedCartToken;
    try {
      const res = await fetch(CART_JS_URL, { credentials: 'same-origin', cache: 'no-store' });
      if (!res.ok) return;
      const cart = await res.json();
      const freshToken = cart && cart.token ? String(cart.token).split('?')[0] : null;
      if (!freshToken || freshToken === oldToken) return; // nothing changed, or nothing to fix

      const rebindRes = await fetch(`${API_URL}/storefront/upload/rebind-cart-token`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          shop: SHOP,
          uploadIds: allUploadedIds,
          oldCartToken: oldToken,
          cartToken: freshToken,
        }),
      });
      if (rebindRes.ok) {
        _cachedCartToken = freshToken; // keep subsequent uploads in this session consistent too
      }
    } catch (e) { /* best-effort — an upload staying on its original token is not fatal */ }
  }

  function watchForAddToCart() {
    const looksLikeCartAdd = (url) => typeof url === 'string' && /\/cart\/add(\.js)?(\?|$)/.test(url);

    const origFetch = window.fetch;
    window.fetch = function (input, init) {
      const url = typeof input === 'string' ? input : (input && input.url);
      const isCartAdd = looksLikeCartAdd(url) && (!init || !init.method || init.method.toUpperCase() === 'POST');
      const p = origFetch.apply(this, arguments);
      if (!isCartAdd) return p;
      // IMPORTANT: chain the rebind INTO the promise handed back to the
      // theme's own code, rather than firing it separately on a delayed
      // timer. Themes that do `fetch('/cart/add', ...).then(() =>
      // location.href = '/checkout')` (no cart page/drawer step — an
      // immediate redirect straight to checkout) will navigate the instant
      // that promise resolves. A detached setTimeout(...,300) loses that
      // race every time: the navigation tears down the page mid-flight and
      // kills our pending rebind fetch before it can complete, silently
      // leaving the upload bound to its stale cart token forever. Awaiting
      // here makes the theme's own .then()-chained navigation wait for us
      // instead — same resolved Response, just slightly later.
      return p.then(async (r) => {
        if (r.ok) { try { await rebindUploadsToRealCartToken(); } catch (e) {} }
        return r;
      });
    };

    const OrigXHR = window.XMLHttpRequest;
    const origOpen = OrigXHR.prototype.open;
    OrigXHR.prototype.open = function (method, url) {
      if (looksLikeCartAdd(url)) {
        this.addEventListener('load', () => {
          if (this.status >= 200 && this.status < 300) setTimeout(rebindUploadsToRealCartToken, 300);
        });
      }
      return origOpen.apply(this, arguments);
    };

    // Traditional (non-AJAX) form submit to /cart/add — the page will
    // navigate away immediately after, so there's no time to call our
    // endpoint here; best-effort attempt fired without blocking submission.
    document.addEventListener('submit', (e) => {
      const form = e.target;
      if (form && form.action && looksLikeCartAdd(form.action)) {
        // Hard stop: don't let the product be added if a required upload is
        // missing. Capture phase + stopImmediatePropagation so this wins even
        // against the theme's own submit handlers.
        if (requiredFieldGetters.length > 0 && !allRequiredSatisfied()) {
          e.preventDefault();
          e.stopImmediatePropagation();
          showGateMessage(true);
          updateAddToCartGate();
          return;
        }
        rebindUploadsToRealCartToken();
      }
    }, true);

    // Safety net for themes whose Add-to-Cart / express buttons don't submit a
    // <form> (AJAX carts, custom buttons, Shop Pay). Intercept the click in the
    // capture phase before the theme's handler runs.
    document.addEventListener('click', (e) => {
      if (requiredFieldGetters.length === 0 || allRequiredSatisfied()) return;
      const target = e.target.closest && e.target.closest(
        'button[type="submit"], input[type="submit"], [name="add"], .product-form__submit, .add-to-cart, [data-add-to-cart], .shopify-payment-button, .shopify-payment-button button',
      );
      if (!target) return;
      // Only intercept within a real cart/add context.
      const inCartForm = target.closest('form[action*="/cart/add"]') || document.querySelector('form[action*="/cart/add"]');
      const isExpress = target.closest('.shopify-payment-button');
      if (!inCartForm && !isExpress) return;
      e.preventDefault();
      e.stopImmediatePropagation();
      showGateMessage(true);
      updateAddToCartGate();
    }, true);
  }
  watchForAddToCart();

  // ── Custom CSS injection ────────────────────────────────────────────────
  // Merchant-defined CSS from Settings → Appearance → Custom CSS.
  // Scoped under #cfup-upload-widget so it can only affect this widget,
  // not the rest of the theme.

  async function loadCustomCss() {
    try {
      const res = await fetch(`${API_URL}/storefront/settings/${encodeURIComponent(SHOP)}`);
      if (!res.ok) return;
      const json = await res.json();
      const css = json?.data?.customCss;
      if (!css) return;

      const styleTag = document.createElement('style');
      styleTag.id = 'cfup-custom-css';
      // Scope every rule under the widget root so merchant CSS can't
      // accidentally (or intentionally) affect the rest of the storefront.
      styleTag.textContent = `#cfup-upload-widget { } \n${css}`;
      document.head.appendChild(styleTag);
    } catch (e) {
      console.error('[CFUP] Failed to load custom CSS:', e);
    }
  }
  loadCustomCss();

  // ── Image editor ─────────────────────────────────────────────────────────

  const modal      = document.getElementById('cfup-editor-modal');
  const editorImg  = document.getElementById('cfup-editor-img');

  async function openEditor(file, onDone) {
    // Load Cropper on demand. If it can't load (CDN blocked/offline), skip the
    // editor and upload the original file rather than trapping the customer.
    const ready = await ensureCropper();
    if (!ready) {
      console.warn('[Filedrop] Image editor unavailable — using the original image.');
      onDone(file);
      return;
    }
    pendingEditorCallback = onDone;
    const url = URL.createObjectURL(file);
    editorImg.src = url;
    editorImg.dataset.objurl = url;
    modal.style.display = 'flex';

    // Small delay so img loads before Cropper reads dimensions
    setTimeout(() => {
      if (cropper) { cropper.destroy(); }
      cropper = new Cropper(editorImg, {
        viewMode: 1,
        autoCropArea: 1,
        movable: true,
        zoomable: true,
        rotatable: true,
        scalable: false,
        responsive: true,
      });
    }, 100);
  }

  function _revokeEditorUrl() {
    if (editorImg.dataset.objurl) {
      URL.revokeObjectURL(editorImg.dataset.objurl);
      delete editorImg.dataset.objurl;
    }
  }

  document.getElementById('cfup-editor-close').addEventListener('click', () => {
    modal.style.display = 'none';
    if (cropper) { cropper.destroy(); cropper = null; }
    _revokeEditorUrl();
    pendingEditorCallback = null;
  });

  document.getElementById('cfup-rotate-left').addEventListener('click', () => cropper?.rotate(-90));
  document.getElementById('cfup-rotate-right').addEventListener('click', () => cropper?.rotate(90));
  document.getElementById('cfup-zoom-in').addEventListener('click', () => cropper?.zoom(0.1));
  document.getElementById('cfup-zoom-out').addEventListener('click', () => cropper?.zoom(-0.1));
  document.getElementById('cfup-reset').addEventListener('click', () => cropper?.reset());

  document.getElementById('cfup-editor-apply').addEventListener('click', () => {
    if (!cropper || !pendingEditorCallback) return;
    cropper.getCroppedCanvas().toBlob((blob) => {
      modal.style.display = 'none';
      cropper.destroy();
      cropper = null;
      _revokeEditorUrl();
      const editedFile = new File([blob], 'edited-image.jpg', { type: 'image/jpeg' });
      pendingEditorCallback(editedFile);
      pendingEditorCallback = null;
    }, 'image/jpeg', 0.92);
  });

  // ── Product preview (composite customer image onto merchant mockup) ────────

  const previewModal   = document.getElementById('cfup-preview-modal');
  const previewCanvas  = document.getElementById('cfup-preview-canvas');
  let pendingPreviewCallback = null;
  let pendingPreviewFile = null;

  function openPreview(templateUrl, placement, file, onConfirm) {
    pendingPreviewCallback = onConfirm;
    pendingPreviewFile = file;
    previewModal.style.display = 'flex';

    const ctx = previewCanvas.getContext('2d');
    const templateImg = new Image();
    templateImg.crossOrigin = 'anonymous';
    templateImg.onload = () => {
      previewCanvas.width = templateImg.naturalWidth;
      previewCanvas.height = templateImg.naturalHeight;
      ctx.drawImage(templateImg, 0, 0);

      // Only composite a live preview for image files — for PDFs/docs/etc.
      // there's nothing to draw, so just show the bare template.
      if (!file.type.startsWith('image/')) return;

      const fileUrl = URL.createObjectURL(file);
      const designImg = new Image();
      designImg.onload = () => {
        const p = placement || { x: 25, y: 25, width: 50, height: 50 };
        const dx = (p.x / 100) * templateImg.naturalWidth;
        const dy = (p.y / 100) * templateImg.naturalHeight;
        const dw = (p.width / 100) * templateImg.naturalWidth;
        const dh = (p.height / 100) * templateImg.naturalHeight;

        // Fit the design image inside the placement box, preserving its
        // aspect ratio, centered — rather than stretching it to fill.
        const scale = Math.min(dw / designImg.naturalWidth, dh / designImg.naturalHeight);
        const drawW = designImg.naturalWidth * scale;
        const drawH = designImg.naturalHeight * scale;
        const drawX = dx + (dw - drawW) / 2;
        const drawY = dy + (dh - drawH) / 2;

        ctx.drawImage(designImg, drawX, drawY, drawW, drawH);
        URL.revokeObjectURL(fileUrl);
      };
      designImg.src = fileUrl;
    };
    templateImg.onerror = () => {
      // Template failed to load (e.g. network hiccup) — don't block the
      // customer's upload over a cosmetic preview failing.
      previewModal.style.display = 'none';
      if (pendingPreviewCallback) pendingPreviewCallback(pendingPreviewFile);
      pendingPreviewCallback = null;
    };
    templateImg.src = templateUrl;
  }

  document.getElementById('cfup-preview-close').addEventListener('click', () => {
    previewModal.style.display = 'none';
    pendingPreviewCallback = null;
    pendingPreviewFile = null;
  });

  document.getElementById('cfup-preview-back').addEventListener('click', () => {
    previewModal.style.display = 'none';
    pendingPreviewCallback = null;
    pendingPreviewFile = null;
  });

  document.getElementById('cfup-preview-confirm').addEventListener('click', () => {
    previewModal.style.display = 'none';
    if (pendingPreviewCallback && pendingPreviewFile) {
      pendingPreviewCallback(pendingPreviewFile);
    }
    pendingPreviewCallback = null;
    pendingPreviewFile = null;
  });

  // ── Interactive designer (drag/resize/rotate image + add text) ─────────────
  // Upgrade over openPreview(): the customer positions their own image and
  // can add text, instead of the merchant fixing one placement for everyone.

  let designerCanvas = null;
  let pendingDesignerCallback = null;
  let designerAreaRect = null;
  let designerPrintArea = null;

  // Keep an object (image or text) fully inside the designated print area:
  // shrink it to fit if it's larger, then nudge it back inside the bounds.
  // This is what enforces "the uploaded image/text must remain within the
  // customization area".
  function constrainToArea(obj) {
    if (!obj || obj === designerAreaRect || !designerPrintArea || !designerCanvas) return;
    const area = designerPrintArea;
    obj.setCoords();
    let b = obj.getBoundingRect(true);
    const cap = Math.min(area.width / b.width, area.height / b.height, 1);
    if (cap < 1) {
      obj.scaleX *= cap;
      obj.scaleY *= cap;
      obj.setCoords();
      b = obj.getBoundingRect(true);
    }
    let left = obj.left, top = obj.top;
    if (b.left < area.left) left += area.left - b.left;
    if (b.top < area.top) top += area.top - b.top;
    if (b.left + b.width > area.left + area.width) left += (area.left + area.width) - (b.left + b.width);
    if (b.top + b.height > area.top + area.height) top += (area.top + area.height) - (b.top + b.height);
    obj.left = left;
    obj.top = top;
    obj.setCoords();
  }

  function updateDesignerToolbar() {
    if (!designerCanvas) return;
    const active = designerCanvas.getActiveObject();
    document.getElementById('cfup-designer-delete-selected').style.display = active ? 'inline-block' : 'none';
    document.getElementById('cfup-designer-text-color').style.display =
      (active && active.type === 'textbox') ? 'inline-block' : 'none';
  }

  async function openDesigner(templateUrl, initialPlacement, file, opts, onConfirm) {
    // Load Fabric on demand. If it can't load (CDN blocked/offline), skip the
    // designer and upload the original file rather than showing a broken modal.
    const ready = await ensureFabric();
    if (!ready) {
      console.warn('[Filedrop] Image designer unavailable — using the original image.');
      onConfirm(file);
      return;
    }
    pendingDesignerCallback = onConfirm;
    const modal = document.getElementById('cfup-designer-modal');
    modal.style.display = 'flex';

    const templateImg = new Image();
    templateImg.crossOrigin = 'anonymous';
    templateImg.onload = () => {
      const maxW = Math.min(640, window.innerWidth - 64);
      // Leave room for the modal's header (~50px), toolbar (~70px), and
      // padding (~80px) so the canvas itself doesn't force the whole
      // modal past the viewport on tall mockup images (e.g. a snowboard).
      const maxH = Math.max(300, window.innerHeight * 0.9 - 200);
      const scale = Math.min(1, maxW / templateImg.naturalWidth, maxH / templateImg.naturalHeight);
      const canvasW = Math.round(templateImg.naturalWidth * scale);
      const canvasH = Math.round(templateImg.naturalHeight * scale);

      if (designerCanvas) { designerCanvas.dispose(); }
      designerCanvas = new fabric.Canvas('cfup-designer-canvas', { width: canvasW, height: canvasH });

      // Compute the designated print area (in canvas pixels) and draw a dashed
      // outline so the customer can see where their design will print — and so
      // we can clamp their art/text inside it (like Spreadshirt's print area).
      const pa = initialPlacement || { x: 25, y: 25, width: 50, height: 50 };
      designerPrintArea = {
        left: (pa.x / 100) * canvasW,
        top: (pa.y / 100) * canvasH,
        width: (pa.width / 100) * canvasW,
        height: (pa.height / 100) * canvasH,
      };
      designerAreaRect = new fabric.Rect({
        left: designerPrintArea.left,
        top: designerPrintArea.top,
        width: designerPrintArea.width,
        height: designerPrintArea.height,
        fill: 'transparent',
        stroke: '#008060',
        strokeDashArray: [6, 4],
        strokeWidth: 1.5,
        selectable: false,
        evented: false,
        excludeFromExport: true,
      });
      designerCanvas.add(designerAreaRect);

      // Clamp any drag/resize/rotate back inside the print area, live.
      designerCanvas.on('object:moving', (e) => constrainToArea(e.target));
      designerCanvas.on('object:scaling', (e) => constrainToArea(e.target));
      designerCanvas.on('object:rotating', (e) => constrainToArea(e.target));
      designerCanvas.on('object:modified', (e) => { constrainToArea(e.target); designerCanvas.renderAll(); });

      fabric.Image.fromURL(templateUrl, (bgImg) => {
        bgImg.scaleToWidth(canvasW);
        designerCanvas.setBackgroundImage(bgImg, designerCanvas.renderAll.bind(designerCanvas));
      }, { crossOrigin: 'anonymous' });

      if (file && file.type.startsWith('image/')) {
        const p = initialPlacement || { x: 25, y: 25, width: 50, height: 50 };
        const fileUrl = URL.createObjectURL(file);
        fabric.Image.fromURL(fileUrl, (img) => {
          const targetW = (p.width / 100) * canvasW;
          const targetH = (p.height / 100) * canvasH;
          const scaleFactor = Math.min(targetW / img.width, targetH / img.height) || 1;
          img.set({
            left: (p.x / 100) * canvasW,
            top: (p.y / 100) * canvasH,
            scaleX: scaleFactor,
            scaleY: scaleFactor,
            cornerColor: '#008060',
            cornerStyle: 'circle',
            transparentCorners: false,
            borderColor: '#008060',
          });
          designerCanvas.add(img);
          constrainToArea(img);
          designerCanvas.setActiveObject(img);
          designerCanvas.renderAll();
          URL.revokeObjectURL(fileUrl);
        }, { crossOrigin: 'anonymous' });
      }

      designerCanvas.on('selection:created', updateDesignerToolbar);
      designerCanvas.on('selection:updated', updateDesignerToolbar);
      designerCanvas.on('selection:cleared', updateDesignerToolbar);

      document.getElementById('cfup-designer-add-text').style.display = opts.allowText ? 'inline-block' : 'none';
    };
    templateImg.src = templateUrl;
  }

  document.getElementById('cfup-designer-close').addEventListener('click', () => {
    document.getElementById('cfup-designer-modal').style.display = 'none';
    pendingDesignerCallback = null;
  });

  document.getElementById('cfup-designer-rotate-left').addEventListener('click', () => {
    const obj = designerCanvas && designerCanvas.getActiveObject();
    if (obj) { obj.rotate((obj.angle || 0) - 15); designerCanvas.renderAll(); }
  });
  document.getElementById('cfup-designer-rotate-right').addEventListener('click', () => {
    const obj = designerCanvas && designerCanvas.getActiveObject();
    if (obj) { obj.rotate((obj.angle || 0) + 15); designerCanvas.renderAll(); }
  });

  document.getElementById('cfup-designer-add-text').addEventListener('click', () => {
    if (!designerCanvas) return;
    const cx = designerPrintArea ? (designerPrintArea.left + designerPrintArea.width / 2) : (designerCanvas.width / 2);
    const cy = designerPrintArea ? (designerPrintArea.top + designerPrintArea.height / 2) : (designerCanvas.height / 2);
    const text = new fabric.Textbox('Your text here', {
      left: cx - 70,
      top: cy - 15,
      width: Math.min(160, designerPrintArea ? designerPrintArea.width : 160),
      fontSize: 28,
      fill: '#000000',
      fontFamily: 'Arial, sans-serif',
      cornerColor: '#008060',
      borderColor: '#008060',
    });
    designerCanvas.add(text);
    constrainToArea(text);
    designerCanvas.setActiveObject(text);
    designerCanvas.renderAll();
    updateDesignerToolbar();
  });

  document.getElementById('cfup-designer-text-color').addEventListener('input', (e) => {
    const obj = designerCanvas && designerCanvas.getActiveObject();
    if (obj && obj.type === 'textbox') {
      obj.set('fill', e.target.value);
      designerCanvas.renderAll();
    }
  });

  document.getElementById('cfup-designer-delete-selected').addEventListener('click', () => {
    const obj = designerCanvas && designerCanvas.getActiveObject();
    if (obj) {
      designerCanvas.remove(obj);
      designerCanvas.discardActiveObject();
      designerCanvas.renderAll();
      updateDesignerToolbar();
    }
  });

  document.getElementById('cfup-designer-confirm').addEventListener('click', () => {
    if (!designerCanvas || !pendingDesignerCallback) return;
    designerCanvas.discardActiveObject();
    if (designerAreaRect) { designerCanvas.remove(designerAreaRect); designerAreaRect = null; }
    designerCanvas.renderAll();
    designerCanvas.getElement().toBlob((blob) => {
      document.getElementById('cfup-designer-modal').style.display = 'none';
      const designedFile = new File([blob], 'custom-design.png', { type: 'image/png' });
      const cb = pendingDesignerCallback;
      pendingDesignerCallback = null;
      cb(designedFile);
    }, 'image/png');
  });

  // ── Fetch fields ─────────────────────────────────────────────────────────

  /**
   * Shopify's dynamic/express checkout buttons (Buy it now, Shop Pay,
   * PayPal, Google Pay — anything rendered by the `payment_button` Liquid
   * filter, always wrapped in a `.shopify-payment-button` div regardless of
   * theme) are documented to skip cart attributes AND line-item properties.
   * They never trigger a `/cart/add` our widget can see, so an uploaded
   * file can never be linked back to an order placed through one of those
   * buttons — no cart-token to rebind, no property to attach, nothing for
   * the orders/create webhook to match. When this product has a REQUIRED
   * upload field, hide those buttons so the customer is forced through
   * "Add to cart" -> Checkout, the only flow this app can actually track.
   * Restored (shown again) when no field on the current variant requires
   * an upload, e.g. after a variant:changed swap.
   */
  function setExpressCheckoutVisible(visible) {
    const form =
      widget.closest('form[action*="/cart/add"]') ||
      document.querySelector('form[action*="/cart/add"]');
    const scope = form || document;
    scope.querySelectorAll('.shopify-payment-button').forEach((el) => {
      el.style.display = visible ? '' : 'none';
    });
  }

  // ── Required-upload gating ────────────────────────────────────────────────
  // A field marked "required" must have at least one successful upload before
  // the product can be added to cart. Previously only the express-checkout
  // buttons were hidden, so a shopper could still use the normal Add-to-Cart
  // and check out with no file — leaving the merchant an order with no artwork.
  function allRequiredSatisfied() {
    return requiredFieldGetters.every((f) => f.getCount() > 0);
  }

  function getCartForms() {
    const forms = new Set();
    const near = widget.closest('form[action*="/cart/add"]');
    if (near) forms.add(near);
    document.querySelectorAll('form[action*="/cart/add"]').forEach((f) => forms.add(f));
    return Array.from(forms);
  }

  function getAddToCartButtons() {
    const btns = new Set();
    getCartForms().forEach((form) => {
      form
        .querySelectorAll(
          'button[type="submit"], input[type="submit"], [name="add"], .product-form__submit, .add-to-cart, [data-add-to-cart]',
        )
        .forEach((b) => btns.add(b));
    });
    return Array.from(btns);
  }

  function showGateMessage(show) {
    let msg = document.getElementById('cfup-required-msg');
    if (show) {
      if (!msg) {
        msg = document.createElement('div');
        msg.id = 'cfup-required-msg';
        msg.className = 'cfup-required-msg';
        msg.setAttribute('role', 'alert');
        msg.textContent = 'Please upload the required file(s) before adding to cart.';
        (container.parentNode || container).insertBefore(msg, container.nextSibling);
      }
      msg.style.display = '';
    } else if (msg) {
      msg.style.display = 'none';
    }
  }

  // Re-evaluate the gate. Called after every upload/removal and on (re)load.
  function updateAddToCartGate() {
    const hasRequired = requiredFieldGetters.length > 0;
    const satisfied = allRequiredSatisfied();
    const block = hasRequired && !satisfied;

    // Express checkout stays hidden until required uploads are present.
    setExpressCheckoutVisible(!block);

    getAddToCartButtons().forEach((btn) => {
      if (block) {
        if (!btn.dataset.cfupGated) {
          btn.dataset.cfupGated = '1';
          // Remember whether the theme had already disabled it, so we only
          // re-enable buttons that WE disabled.
          btn.dataset.cfupWasDisabled = btn.disabled ? '1' : '0';
        }
        btn.disabled = true;
        btn.classList.add('cfup-disabled');
        btn.setAttribute('aria-disabled', 'true');
      } else if (btn.dataset.cfupGated) {
        if (btn.dataset.cfupWasDisabled !== '1') btn.disabled = false;
        btn.classList.remove('cfup-disabled');
        btn.removeAttribute('aria-disabled');
        delete btn.dataset.cfupGated;
        delete btn.dataset.cfupWasDisabled;
      }
    });

    if (!block) showGateMessage(false);
  }

  async function loadFields() {
    // Rebuild the required-field registry from scratch on every (re)load,
    // including variant changes.
    requiredFieldGetters.length = 0;
    const variantId = widget.dataset.variantId;
    try {
      const url = new URL(`${API_URL}/storefront/fields`);
      url.searchParams.set('shop', SHOP);
      url.searchParams.set('productId', PRODUCT_ID);
      if (variantId) url.searchParams.set('variantId', variantId);

      const res = await fetch(url.toString());
      if (!res.ok) {
        // A 404 here almost always means the backend couldn't match this store
        // (e.g. the widget sent a domain the merchant isn't registered under).
        console.error(
          `[Filedrop] Could not load upload fields (HTTP ${res.status}) for shop "${SHOP}". ` +
          `If this is a live store, confirm the app is installed on it and the shop domain matches.`,
        );
        return;
      }
      const json = await res.json();
      const fields = json.data || [];
      if (!fields.length) {
        console.info('[Filedrop] No active upload fields are assigned to this product. Create a field (or assign one store-wide) in the Filedrop admin.');
      }
      fields.forEach((field) => container.appendChild(buildField(field)));
    } catch (e) {
      console.error('[CFUP] Failed to load upload fields:', e);
    }
    // Apply the gate whether or not fields loaded (fail-open: if we couldn't
    // load fields, there are no known required fields, so don't block).
    updateAddToCartGate();
  }

  // Rebuild on variant change
  document.addEventListener('variant:changed', (e) => {
    const v = e?.detail?.variant;
    if (v) {
      widget.dataset.variantId = v.id;
      if (v.featured_image && v.featured_image.src) {
        PRODUCT_IMAGE = v.featured_image.src;
      }
      container.innerHTML = '';
      allUploadedIds = [];
      loadFields();
    }
  });

  // ── Build a single field UI ───────────────────────────────────────────────

  function buildField(field) {
    const uploadedFiles = [];
    const uploadedFileIds = [];

    // Register required fields so the Add-to-Cart gate can check whether each
    // one has at least one upload. The getter reads the live array length.
    if (field.required) {
      requiredFieldGetters.push({ id: field.id, getCount: () => uploadedFileIds.length });
    }

    const wrapper = document.createElement('div');
    wrapper.className = 'cfup-field-wrapper';

    // Label
    if (field.label) {
      const label = document.createElement('label');
      label.className = 'cfup-field-label';
      label.textContent = field.label;
      if (field.required) {
        const star = document.createElement('span');
        star.className = 'cfup-required';
        star.textContent = ' *';
        label.appendChild(star);
      }
      wrapper.appendChild(label);
    }

    // Description
    if (field.description) {
      const desc = document.createElement('p');
      desc.className = 'cfup-field-description';
      desc.textContent = field.description;
      wrapper.appendChild(desc);
    }

    // Dropzone
    const dropzone = document.createElement('div');
    dropzone.className = 'cfup-dropzone';

    const icon = document.createElement('span');
    icon.className = 'cfup-dropzone-icon';
    icon.textContent = field.fieldType === 'image' ? '🖼️' : field.fieldType === 'pdf' ? '📄' : '📎';
    dropzone.appendChild(icon);

    const dropText = document.createElement('p');
    dropText.className = 'cfup-dropzone-text';
    dropText.textContent = 'Drag & drop files here or choose below';
    dropzone.appendChild(dropText);

    // Hidden file input (browse)
    const fileInput = document.createElement('input');
    fileInput.type = 'file';
    fileInput.style.cssText = 'position:absolute;inset:0;opacity:0;cursor:pointer;';
    fileInput.multiple = field.maxFiles > 1;
    if (field.allowedExtensions?.length) {
      var acceptExts = field.allowedExtensions.map(function (e) { return '.' + e; });
      // iPhone photos are HEIC. They're converted to JPEG on the server, so a
      // field that allows common image types should also let HEIC be picked.
      var allowsImages = field.allowedExtensions.some(function (e) {
        return ['jpg', 'jpeg', 'png', 'webp', 'gif', 'heic', 'heif'].indexOf(e.toLowerCase()) !== -1;
      });
      if (allowsImages) { acceptExts.push('.heic', '.heif'); }
      fileInput.accept = acceptExts.join(',');
    } else if (field.fieldType === 'image') {
      fileInput.accept = 'image/*';
    }
    dropzone.appendChild(fileInput);
    wrapper.appendChild(dropzone);

    // Action buttons
    const actions = document.createElement('div');
    actions.className = 'cfup-upload-actions';

    const browseBtn = document.createElement('button');
    browseBtn.className = 'cfup-button';
    browseBtn.textContent = field.buttonText || BTN_TEXT;
    browseBtn.type = 'button';
    browseBtn.addEventListener('click', (e) => { e.stopPropagation(); fileInput.click(); });
    actions.appendChild(browseBtn);

    // Camera button (mobile/desktop)
    if (ENABLE_CAMERA && (field.fieldType === 'image' || field.fieldType === 'custom')) {
      const camInput = document.createElement('input');
      camInput.type = 'file';
      camInput.accept = 'image/*';
      camInput.capture = 'environment';
      camInput.style.display = 'none';
      wrapper.appendChild(camInput);

      const camBtn = document.createElement('button');
      camBtn.className = 'cfup-button-secondary';
      camBtn.type = 'button';
      camBtn.textContent = '📷 Camera';
      camBtn.addEventListener('click', (e) => { e.stopPropagation(); camInput.click(); });
      actions.appendChild(camBtn);

      camInput.addEventListener('change', () => {
        if (camInput.files?.length) handleFiles(Array.from(camInput.files));
        camInput.value = '';
      });
    }

    wrapper.appendChild(actions);

    // Progress
    const progressWrapper = document.createElement('div');
    progressWrapper.style.display = 'none';
    const track = document.createElement('div');
    track.className = 'cfup-progress-bar-track';
    const fill = document.createElement('div');
    fill.className = 'cfup-progress-bar-fill';
    const progressText = document.createElement('p');
    progressText.className = 'cfup-progress-text';
    track.appendChild(fill);
    progressWrapper.className = 'cfup-progress-bar-wrapper';
    progressWrapper.appendChild(track);
    progressWrapper.appendChild(progressText);
    wrapper.appendChild(progressWrapper);

    // File list
    const fileList = document.createElement('div');
    fileList.className = 'cfup-file-list';
    wrapper.appendChild(fileList);

    // Error
    const errorEl = document.createElement('div');
    errorEl.className = 'cfup-error';
    errorEl.style.display = 'none';
    wrapper.appendChild(errorEl);

    // Help text
    if (field.helpText) {
      const help = document.createElement('p');
      help.className = 'cfup-help-text';
      help.textContent = field.helpText;
      wrapper.appendChild(help);
    }

    // ── Drag & drop ────────────────────────────────────────────────────────

    dropzone.addEventListener('dragover', (e) => {
      e.preventDefault();
      dropzone.classList.add('cfup-dragover');
    });
    dropzone.addEventListener('dragleave', () => dropzone.classList.remove('cfup-dragover'));
    dropzone.addEventListener('drop', (e) => {
      e.preventDefault();
      dropzone.classList.remove('cfup-dragover');
      handleFiles(Array.from(e.dataTransfer.files));
    });

    fileInput.addEventListener('change', () => {
      handleFiles(Array.from(fileInput.files));
      fileInput.value = '';
    });

    function showError(msg) {
      errorEl.textContent = msg;
      errorEl.style.display = 'block';
      setTimeout(() => { errorEl.style.display = 'none'; }, 6000);
    }

    function handleFiles(files) {
      errorEl.style.display = 'none';
      if (uploadedFiles.length + files.length > (field.maxFiles || 1)) {
        showError(`Maximum ${field.maxFiles} file(s) allowed`);
        return;
      }

      const proceedToUpload = (f) => {
        // Prefer the ACTUAL product photo as the compositing/design
        // canvas over a merchant-uploaded generic mockup. A single
        // uploaded template can't realistically match every product in
        // the store (e.g. a blank bottle mockup showing up underneath a
        // snowboard design) since Upload Fields are commonly assigned to
        // the entire store rather than per-product. The real product
        // image is always correct for whichever product the customer is
        // actually viewing. The merchant's custom template (if any) is
        // still used as a fallback for products with no image at all.
        const canvasImage = PRODUCT_IMAGE || field.previewTemplateUrl;

        if (field.enablePreview && canvasImage && field.allowCustomerPositioning) {
          // Full designer: customer drags/resizes/rotates their image and
          // can add text — this replaces the fixed compositing preview.
          openDesigner(
            canvasImage,
            field.previewPlacement,
            f,
            { allowText: !!field.allowCustomerText },
            (designedFile) => uploadFile(designedFile),
          );
        } else if (field.enablePreview && canvasImage) {
          // Simpler mode: fixed placement, preview-only confirmation.
          openPreview(canvasImage, field.previewPlacement, f, (confirmedFile) => uploadFile(confirmedFile));
        } else {
          uploadFile(f);
        }
      };

      files.forEach((file) => {
        // If image editing is enabled AND we're not going into the full
        // designer (which has its own rotate/resize), open the crop editor first.
        const skipCropBecauseDesigner = field.enablePreview && field.allowCustomerPositioning;
        if (field.enableCropping && file.type.startsWith('image/') && !skipCropBecauseDesigner) {
          openEditor(file, (editedFile) => proceedToUpload(editedFile));
        } else {
          proceedToUpload(file);
        }
      });
    }

    async function uploadFile(file) {
      // Client-side validation
      const maxBytes = (field.maxFileSizeMb || 10) * 1024 * 1024;
      if (file.size > maxBytes) {
        showError(`${file.name} exceeds the ${field.maxFileSizeMb}MB limit`);
        return;
      }

      const minBytes = (field.minFileSizeMb || 0) * 1024 * 1024;
      if (minBytes && file.size < minBytes) {
        showError(`${file.name} is too small (min ${field.minFileSizeMb}MB)`);
        return;
      }

      const ext = file.name.split('.').pop()?.toLowerCase();
      // Let iPhone HEIC through even on a "jpg/png only" field — the server
      // converts it to JPEG, so it satisfies the merchant's image intent.
      var heicOk = (ext === 'heic' || ext === 'heif') &&
        field.allowedExtensions?.some(function (e) {
          return ['jpg', 'jpeg', 'png', 'webp', 'gif', 'heic', 'heif'].indexOf(e.toLowerCase()) !== -1;
        });
      if (field.allowedExtensions?.length && !field.allowedExtensions.includes(ext) && !heicOk) {
        showError(`File type .${ext} is not allowed`);
        return;
      }

      // Show progress
      progressWrapper.style.display = 'block';
      fill.style.width = '0%';
      progressText.textContent = 'Uploading...';

      const fileItem = createFileItem(file, 'uploading');
      fileList.appendChild(fileItem);

      try {
        const formData = new FormData();
        formData.append('file', file);
        formData.append('shop', SHOP);
        formData.append('productId', PRODUCT_ID);
        const variantId = widget.dataset.variantId;
        if (variantId) formData.append('variantId', variantId);
        formData.append('uploadFieldId', field.id);
        const cartToken = await getCartToken();
        if (cartToken) formData.append('cartToken', cartToken);

        const xhr = new XMLHttpRequest();
        xhr.open('POST', `${API_URL}/storefront/upload`);

        xhr.upload.onprogress = (e) => {
          if (e.lengthComputable) {
            const pct = Math.round((e.loaded / e.total) * 100);
            fill.style.width = pct + '%';
            progressText.textContent = `Uploading... ${pct}%`;
          }
        };

        await new Promise((resolve, reject) => {
          xhr.onload = () => {
            if (xhr.status >= 200 && xhr.status < 300) {
              const res = JSON.parse(xhr.responseText);
              uploadedFiles.push(res.data);
              uploadedFileIds.push(res.data.id);
              allUploadedIds.push(res.data.id);
              if (res.data.previewUrl) {
                allUploadedPreviews.push(res.data.previewUrl);
              }
              updateFileItem(fileItem, 'success', '✓ Uploaded');
              progressWrapper.style.display = 'none';
              addRemoveButton(fileItem, res.data.id, uploadedFiles, uploadedFileIds);
              persistUploadIds();
              syncLineItemProperties();
              resolve(res);
            } else {
              let msg = 'Upload failed. Please try again.';
              if (xhr.status === 413) {
                msg = 'This file is too large to upload.';
              } else if (xhr.status === 429) {
                msg = 'Too many uploads in a short time. Please wait a moment and try again.';
              } else {
                try {
                  const err = JSON.parse(xhr.responseText);
                  if (err && err.message) {
                    msg = Array.isArray(err.message) ? err.message.join(', ') : err.message;
                  }
                } catch { /* non-JSON error body — keep the generic message */ }
              }
              reject(new Error(msg));
            }
          };
          xhr.onerror = () => reject(new Error('Network error'));
          xhr.send(formData);
        });

      } catch (err) {
        updateFileItem(fileItem, 'error', '✗ Failed');
        showError(err.message || 'Upload failed. Please try again.');
        progressWrapper.style.display = 'none';
      }
    }

    function addRemoveButton(item, uploadId, filesArr, idsArr) {
      const btn = document.createElement('button');
      btn.className = 'cfup-file-remove';
      btn.textContent = '✕';
      btn.title = 'Remove';
      btn.addEventListener('click', async () => {
        // Soft-delete on server
        try {
          const delUrl = new URL(`${API_URL}/storefront/upload/${uploadId}`);
          delUrl.searchParams.set('merchantId', SHOP);
          const cartTokenForDelete = await getCartToken();
          if (cartTokenForDelete) delUrl.searchParams.set('cartToken', cartTokenForDelete);
          await fetch(delUrl.toString(), { method: 'DELETE' });
        } catch { /* best-effort */ }
        const idx = idsArr.indexOf(uploadId);
        if (idx !== -1) { filesArr.splice(idx, 1); idsArr.splice(idx, 1); }
        const globalIdx = allUploadedIds.indexOf(uploadId);
        if (globalIdx !== -1) {
          allUploadedIds.splice(globalIdx, 1);
          allUploadedPreviews.splice(globalIdx, 1);
        }
        item.remove();
        persistUploadIds();
        syncLineItemProperties();
      });
      item.appendChild(btn);
    }

    return wrapper;
  }

  // ── File item helpers ─────────────────────────────────────────────────────

  function createFileItem(file, status) {
    const item = document.createElement('div');
    item.className = 'cfup-file-item';

    if (file.type.startsWith('image/')) {
      const img = document.createElement('img');
      img.className = 'cfup-file-preview';
      img.src = URL.createObjectURL(file);
      img.onload = () => URL.revokeObjectURL(img.src);
      item.appendChild(img);
    } else {
      const icon = document.createElement('span');
      icon.style.cssText = 'font-size:32px;flex-shrink:0';
      icon.textContent = getFileIcon(file.type);
      item.appendChild(icon);
    }

    const info = document.createElement('div');
    info.className = 'cfup-file-info';
    info.innerHTML = `
      <div class="cfup-file-name">${escapeHtml(file.name)}</div>
      <div class="cfup-file-size">${formatBytes(file.size)}</div>
    `;
    item.appendChild(info);

    const statusEl = document.createElement('span');
    statusEl.className = `cfup-file-status ${status}`;
    statusEl.textContent = status === 'uploading' ? '⏳ Uploading...' : '';
    item.appendChild(statusEl);
    item._statusEl = statusEl;

    return item;
  }

  function updateFileItem(item, status, text) {
    item._statusEl.className = `cfup-file-status ${status}`;
    item._statusEl.textContent = text;
  }

  function getFileIcon(mimeType) {
    if (mimeType.includes('pdf')) return '📄';
    if (mimeType.includes('video')) return '🎬';
    if (mimeType.includes('zip')) return '🗜️';
    if (mimeType.includes('word')) return '📝';
    return '📎';
  }

  function escapeHtml(str) {
    return str.replace(/[&<>"']/g, (m) => ({ '&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;' }[m]));
  }

  function formatBytes(b) {
    if (b < 1024) return b + ' B';
    if (b < 1048576) return (b / 1024).toFixed(1) + ' KB';
    return (b / 1048576).toFixed(1) + ' MB';
  }

  // ── Cart persistence ──────────────────────────────────────────────────────

  /**
   * Returns the shopper's REAL, DURABLE Shopify cart token.
   *
   * IMPORTANT: this deliberately uses POST /cart/update.js with a no-op
   * payload, NOT GET /cart.js. On a cart that has no items yet (the normal
   * case here, since the customer uploads a file BEFORE clicking "Add to
   * cart"), a read-only GET /cart.js can return a token that is not yet
   * Shopify's final, persisted cart identity — Shopify only durably commits
   * to a cart once it's actually mutated. That provisional token then never
   * matches order.cart_token from the orders/create webhook later, even
   * though it looked like a perfectly valid token at the time.
   *
   * POSTing a harmless empty update forces Shopify to instantiate (or
   * confirm) the real, persistent cart right now and returns that cart's
   * actual token — the same one that will end up on the resulting order.
   */
  async function getCartToken() {
    if (_cachedCartToken) return _cachedCartToken;
    try {
      const res = await fetch(CART_UPDATE_URL, {
        method: 'POST',
        credentials: 'same-origin',
        cache: 'no-store',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ updates: {} }),
      });
      if (res.ok) {
        const cart = await res.json();
        if (cart && cart.token) {
          // Some store configurations still append "?key={checkoutKey}" to
          // the token — strip it, since order.cart_token is always bare.
          _cachedCartToken = String(cart.token).split('?')[0];
          return _cachedCartToken;
        }
      }
    } catch (e) { /* network hiccup — fall through */ }

    // Fallback: try a plain GET, in case /cart/update.js is blocked by a
    // theme customization or cart-mutation restriction. Better than
    // nothing, though it carries the provisional-token risk described above.
    try {
      const res = await fetch(CART_JS_URL, { credentials: 'same-origin', cache: 'no-store' });
      if (res.ok) {
        const cart = await res.json();
        if (cart && cart.token) {
          _cachedCartToken = String(cart.token).split('?')[0];
          return _cachedCartToken;
        }
      }
    } catch (e) { /* fall through to cookie */ }

    // Last resort: read the cookie if Shopify has already set one.
    // Deliberately no random-token fallback — an upload that can never be
    // matched to an order is worse than one that stays unlinked and visible
    // in "All Uploads" for manual reconciliation.
    const m = document.cookie.match(/cart=([^;]+)/);
    if (m) {
      _cachedCartToken = decodeURIComponent(m[1]).split('?')[0];
      return _cachedCartToken;
    }
    return null;
  }

  function persistUploadIds() {
    if (!allUploadedIds.length) return;
    fetch(CART_UPDATE_URL, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        attributes: {
          '_cfup_upload_ids': allUploadedIds.join(','),
          '_cfup_product_id': PRODUCT_ID,
        },
      }),
    }).catch(() => {});
  }

  /**
   * Write the uploaded files as Shopify LINE-ITEM PROPERTIES on the product
   * form. Unlike cart attributes, line-item properties are attached to the
   * specific product line, so Shopify renders them directly under that product
   * on the order page — which is where the store owner wants to see the file.
   *
   * We inject hidden inputs named `properties[Uploaded file]`,
   * `properties[Uploaded file 2]`, … into the product's add-to-cart <form>.
   * The value is the public preview URL, so it shows as a clickable link the
   * merchant can open to preview/download. This travels with the order
   * guaranteed — no dependency on cart-token matching.
   */
  function syncLineItemProperties() {
    // Every upload/removal flows through here — re-check the required gate.
    updateAddToCartGate();

    // Find the product form this widget belongs to.
    const form =
      widget.closest('form[action*="/cart/add"]') ||
      document.querySelector('form[action*="/cart/add"]');
    if (!form) return;

    // Remove any properties we previously injected, so removals are reflected.
    form.querySelectorAll('input[data-cfup-prop="1"]').forEach((el) => el.remove());

    allUploadedPreviews.forEach((url, i) => {
      if (!url) return;
      const input = document.createElement('input');
      input.type = 'hidden';
      input.setAttribute('data-cfup-prop', '1');
      // Shopify shows the property label + value under the line item. A blank
      // label prefix ("_"?) would hide it; we want it visible, so use a clear
      // human label. Multiple files get numbered labels.
      input.name = 'properties[Uploaded file' + (i === 0 ? '' : ' ' + (i + 1)) + ']';
      input.value = url;
      form.appendChild(input);
    });

    // Also attach the raw upload ids as ONE hidden line-item property. The
    // leading underscore keeps it out of the storefront/checkout/email
    // display, but it still travels on the order — giving the orders/create
    // webhook a dedicated, reliable id channel that does NOT depend on
    // cart_token (which Shopify sends as null for PayPal / Shop Pay / express
    // checkouts) NOR on parsing a preview URL. This is what makes the
    // customised image reliably appear in both Filedrop's Orders view and the
    // native Shopify order page. See WebhooksService.resolveUploadsForOrder().
    if (allUploadedIds.length) {
      const idInput = document.createElement('input');
      idInput.type = 'hidden';
      idInput.setAttribute('data-cfup-prop', '1');
      idInput.name = 'properties[_Filedrop Upload IDs]';
      idInput.value = allUploadedIds.join(',');
      form.appendChild(idInput);
    }
  }

  // ── Init ──────────────────────────────────────────────────────────────────

  loadFields();
})();
</script>

